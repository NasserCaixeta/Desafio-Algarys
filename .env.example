# Application
APP_NAME=Clinic Confirmations
APP_VERSION=1.0.0
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
LOG_JSON=true

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_BYTES=5242880
DEPENDENCY_TIMEOUT_SECONDS=2

# PostgreSQL
POSTGRES_DB=clinic_confirmations
POSTGRES_TEST_DB=clinic_confirmations_test
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_local_password
DATABASE_URL=postgresql+psycopg://clinic:clinic_local_password@postgres:5432/clinic_confirmations
TEST_DATABASE_URL=postgresql+psycopg://clinic:clinic_local_password@localhost:5433/clinic_confirmations_test

# Redis and Celery
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://localhost:6380/0
CELERY_QUEUE=confirmations
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
RECONCILIATION_INTERVAL_SECONDS=5
RECONCILIATION_BATCH_SIZE=100

# Processing, retry and deterministic sender
MAX_MESSAGE_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=5
RETRY_BACKOFF_MAX_SECONDS=300
PROCESSING_LEASE_SECONDS=120
SIMULATED_FAILURE_SUFFIXES=0000
SIMULATED_FAILURE_ATTEMPTS=1
SIMULATED_LATENCY_MS=250

# Frontend build (blank uses the same origin through Nginx /api proxy)
VITE_API_URL=
VITE_API_TIMEOUT_MS=10000
VITE_POLL_INTERVAL_MS=2000
